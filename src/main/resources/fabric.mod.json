{
  "schemaVersion": 1,
  "id": "jsonpatcher",
  "version": "${version}",
  "name": "JsonPatcher",
  "description": "A tool for patching json resource files easily and with great compatibility.",
  "authors": ["MattiDragon"],
  "contact": {
    "repo": "https://github.com/MattiDragon/JsonPatcher",
    "homepage": "https://modrinth.com/mod/jsonpatcher"
  },
  "license": "MIT",
  "icon": "assets/jsonpatcher/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.mattidragon.jsonpatcher.JsonPatcher"
    ],
    "client": [
      "dev.mattidragon.jsonpatcher.client.JsonPatcherClient"
    ]
  },
  "accessWidener" : "jsonpatcher.accesswidener",
  "mixins": [
    "jsonpatcher.mixins.json",
    {
      "config": "client.jsonpatcher.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": "~26.1"
  }
}
