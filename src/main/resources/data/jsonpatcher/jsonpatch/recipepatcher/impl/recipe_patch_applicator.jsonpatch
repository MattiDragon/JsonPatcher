@version "2";
@target {
    "path": {
        "start": "recipe/",
        "end": ".json"
    }
};
@feature_flag "jsonpatcher:recipepatcher";

import "jsonpatcher:recipepatcher" as recipepatcher;
import "jsonpatcher:recipepatcher/templates" as templates;

# @@type recipepatcher.Template | null
val template = templates.getTemplate($type);
if (template == null) return;

# @@arg path {string | number}[]
# @@arg value any
function set(path, value) {
    # @@type object | array
    var current = $;
    for (var i = 0; i < path.length - 1; i++) {
        current = current[path[i]];
    }
    current[path[-1]] = value;
}

# @@arg id string
function normalizeId(id) {
    return id.contains(":") ? id : "minecraft:\{id}";
}

val ingredients = [];
val results = [];
val fields = {};

# @@type recipepatcher.TemplateCollector
val collector = values.freeze({
    addIngredient: (path, ingredient) -> {
        if (ingredient is object && "fabric:type" in ingredient) {
            templates.getIngredientTemplate(normalizeId(ingredient.'fabric:type'))(collector, path, ingredient);
        } else {
            ingredients.push({path: path, ingredient: ingredient});
        }
    },
    addResult: (path, stack) -> {
        results.push({path: path, stack: stack});
    },
    addValue: (name, path, value) -> {
        if (!(name in fields)) {
            fields[name] = [];
        }
        fields[name].push({path: path, value: value});
    }
});


template(collector, [], $);

recipepatcher._internal_use((state) -> {
    foreach (ingredient in ingredients) {
        var changed = false;
        # @@type recipepatcher.Ingredient
        var current = ingredient.ingredient;

        if (current is string && current in state.ingredientReplacements) {
            current = state.ingredientReplacements[current];
            changed = true;
        } else if (current is array) {
            for (var i = 0; i < current.length; i++) {
                # TODO: shallow copy array here to avoid breaking things weirdly
                if (current[i] in state.ingredientReplacements) {
                    current[i] = state.ingredientReplacements[current[i]];
                    changed = true;
                }
            }
        }

        foreach (transform in state.ingredientTransforms) {
            val transformed = transform(current);
            if (transformed != null) {
                current = transformed;
                changed = true;
            }
        }

        if (changed) {
            set(ingredient.path, current);
        }
    }

    foreach (result in results) {
        var changed = false;
        # @@type recipepatcher.ItemStack
        var current = result.stack;

        if (current is string && current in state.outputReplacements) {
            current = state.outputReplacements[current];
            changed = true;
        } else if (current.id in state.outputReplacements) {
            # TODO: shallow copy array here to avoid breaking things weirdly
            current.id = state.outputReplacements[current.id];
            changed = true;
        }

        foreach (transform in state.outputTransforms) {
            val transformed = transform(current);
            if (transformed != null) {
                current = transformed;
                changed = true;
            }
        }

        if (changed) {
            set(result.path, current);
        }
    }

    foreach (key in objects.keys(state.fieldTransforms)) {
        if (!(key in fields)) continue;

        foreach (value in fields[key]) {
            var changed = false;
            var current = value.value;

            foreach (transform in state.fieldTransforms[key]) {
                val transformed = transform(current);
                if (transformed != null) {
                    current = transformed;
                    changed = true;
                }
            }

            if (changed) {
                set(value.path, current);
            }
        }
    }

    val type = normalizeId($type);

    if (type in state.recipeTransforms) {
        foreach (recipeTransform in state.recipeTransforms[type]) {
            recipeTransform($);
        }
    }
});
