#| module metapatch
#| A special library available to metapatch patches.
#| Provides tools to create, query and remove files on a higher level.

#| value metapatch.createFile: (path: string, content: any) -> void
#| Creates a file at the specified path with the specified content, converted to json.

#| value metapatch.deleteFile: (path: string) -> void
#| Deletes the file at the specified path.

#| value metapatch.getFile: (path: string) -> object
#| Reads the file at the specified path and returns its content as json.