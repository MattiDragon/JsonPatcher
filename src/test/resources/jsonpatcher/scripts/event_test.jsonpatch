@version "2";
@init "main";

import "reflection";
import "events";

val InteractionResult = reflection.findClass("net.minecraft.world.InteractionResult");
val ItemStack = reflection.findClass("net.minecraft.world.item.ItemStack");

val eventContainer = events.container("test");

eventContainer.registerFabric("net.fabricmc.fabric.api.event.player.UseItemCallback", "EVENT", (player, level, hand) -> {
    debug.log(player);
    return InteractionResult.Pass();
});