@version "2";
@target "minecraft:recipe/diamond_pickaxe.json";

import "reflection";

for (var i = 0; i < 100; i++) {
    val ResourceLocation = reflection.findClass("net.minecraft.resources.ResourceLocation");
    ResourceLocation.withDefaultNamespace("hell0");
}
