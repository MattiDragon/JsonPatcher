@version "1";
@metapatch;

metapatch.deleteFile("minecraft:recipes/diamond_boots.json");

metapatch.deleteFiles({namespace: "minecraft", path: {start: "recipes/", end: "_sign.json"}});

metapatch.addFile("minecraft:recipes/test.json", {
    type: "crafting_shaped",
    category: "redstone",
    pattern: [
        "###",
        "XXX",
        "###"
    ],
    key: {
        '#': {
            item: "minecraft:oak_planks"
        },
        'X': {
            item: "minecraft:stick"
        }
    },
    result: {
        id: "minecraft:stick",
        count: 3
    }
});

metapatch.addFile("minecraft:loot_tables/blocks/andesite.json", metapatch.getFile("minecraft:loot_tables/blocks/stone.json"));