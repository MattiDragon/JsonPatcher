@version "2";
@metapatch;

import "metapatch";

metapatch.deleteFile("minecraft:recipe/diamond_boots.json");

metapatch.deleteFiles({namespace: "minecraft", path: {start: "recipe/", end: "_sign.json"}});

metapatch.addFile("minecraft:recipe/test.json", {
    type: "crafting_shaped",
    category: "redstone",
    pattern: [
        "###",
        "XXX",
        "###"
    ],
    key: {
        '#': {
            item: "minecraft:oak_planks"
        },
        'X': {
            item: "minecraft:stick"
        }
    },
    result: {
        id: "minecraft:stick",
        count: 3
    }
});

metapatch.addFile("minecraft:loot_table/blocks/andesite.json", metapatch.getFile("minecraft:loot_table/blocks/stone.json"));